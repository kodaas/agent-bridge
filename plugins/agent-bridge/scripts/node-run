#!/bin/sh
# Find a Node.js 18+ runtime and exec it with the given arguments.
# Hosts may start plugin processes with a minimal PATH, so look in the usual places.
set -u
PATH="${PATH:-/usr/bin:/bin}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
export PATH

usable() {
  [ -n "$1" ] && [ -x "$1" ] &&
    "$1" -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 18 ? 0 : 1)' >/dev/null 2>&1
}

for candidate in \
  "${AGENT_BRIDGE_NODE:-}" \
  "$(command -v node 2>/dev/null)" \
  /opt/homebrew/bin/node \
  /usr/local/bin/node \
  "${HOME:-}/.volta/bin/node" \
  "${CODEX_MCP_NODE_PATH:-}" \
  "${XDG_CACHE_HOME:-${HOME:-}/.cache}/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node"
do
  if usable "$candidate"; then exec "$candidate" "$@"; fi
done

for candidate in $(ls -1d "${HOME:-}"/.nvm/versions/node/*/bin/node "${HOME:-}"/.local/share/fnm/node-versions/*/installation/bin/node 2>/dev/null | sort -r); do
  if usable "$candidate"; then exec "$candidate" "$@"; fi
done

echo "agent-bridge: Node.js 18+ not found. Install Node.js or set AGENT_BRIDGE_NODE=/path/to/node." >&2
exit 127
